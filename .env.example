# Application Configuration
APP_NAME=RecoverAI
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-super-secret-key-32-chars-min
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite fallback for tests)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recoverai
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/recoverai
# For lightweight local SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./recoverai.db
# DATABASE_URL_SYNC=sqlite:///./recoverai.db

# Redis & Celery (Async Jobs)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Provider Configuration (Provider-Agnostic)
# Supported: gemini, openai, anthropic, mock
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payment Provider Configuration
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
